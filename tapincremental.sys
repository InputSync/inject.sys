-- New toggles for improved features
sections.Left:Toggle({
    Name = "Teleport Mode",
    Default = false,
    Callback = function(Value)
        Func.TeleportMode = Value
        Window:Notify({
            Title = Window.Settings.Title,
            Description = (Value and "Enabled" or "Disabled") .. " Teleport Mode — instant target collection",
            Lifetime = 3,
        })
    end,
}, "TeleportMode")

sections.Left:Toggle({
    Name = "Anti-Stuck",
    Default = true,
    Callback = function(Value)
        Func.AntiStuck = Value
        Window:Notify({
            Title = Window.Settings.Title,
            Description = (Value and "Enabled" or "Disabled") .. " Anti-Stuck",
            Lifetime = 3,
        })
    end,
}, "AntiStuck")

-- Ore Type selector — dynamically populated from the Ores folder's
-- "Currency" attribute. "All" mines every ore; anything else ignores
-- any ore whose Currency doesn't match.
local initialOreTypes = DiscoverOreTypes()
local oreDropdown = sections.Left:Dropdown({
    Name = "Target Ore Type",
    Default = "All",
    Options = initialOreTypes,
    Callback = function(Value)
        Func.TargetOreType = Value
        Window:Notify({
            Title = Window.Settings.Title,
            Description = "Mining: " .. Value,
            Lifetime = 3,
        })
    end,
}, "OreTypeDropdown")

-- Periodically refresh the dropdown options so newly-spawned ore types
-- appear without reloading the script. Uses pcall + tries multiple
-- method names since MacLib versions differ.
local lastOreTypeList = initialOreTypes
task.spawn(function()
    while true do
        task.wait(5)
        local newTypes = DiscoverOreTypes()
        if #newTypes ~= #lastOreTypeList then
            lastOreTypeList = newTypes
            pcall(function()
                if oreDropdown.SetValues then oreDropdown:SetValues(newTypes) end
            end)
            pcall(function()
                if oreDropdown.SetOptions then oreDropdown:SetOptions(newTypes) end
            end)
            pcall(function()
                if oreDropdown.Refresh then oreDropdown:Refresh(newTypes) end
            end)
        end
    end
end)

