--[[
    inject.sys _
    Tap Incremental — Improved Edition
]]

local MacLib = loadstring(game:HttpGet("https://github.com/biggaboy212/Maclib/releases/latest/download/maclib.txt"))()

--# Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

--# Variables (with respawn handling)
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Watch for character respawns so the loops don't break when you die
local function RefreshCharacter(newChar)
    Character = newChar
    RootPart = newChar:WaitForChild("HumanoidRootPart")
end
Player.CharacterAdded:Connect(RefreshCharacter)

--# Feature state
local Func = {
    LoopDelay = 0,
    HoverHeight = 4,
    MoveSpeed = 300,           -- NEW: max flight speed (was capped at 100)
    ReachDistance = 1.5,       -- NEW: distance to consider "reached"
    TeleportMode = false,      -- NEW: instant teleport to targets
    AntiStuck = true,          -- NEW: auto-teleport if stuck
    CollectionDelay = 0.05,    -- NEW: delay between collections

    AutoTapRunning = false,
    AutoFarmFruitsRunning = false,
    AutoMineOresRunning = false,

    -- Ore type selector: "All" mines every ore, anything else mines only
    -- ores whose :GetAttribute("Currency") matches (e.g. "Copper", "Iron").
    TargetOreType = "All",
}

--# Helper: Create a high-force BodyVelocity (40x stronger than original)
local function CreateMover(maxForceY)
    local BV = Instance.new("BodyVelocity")
    BV.MaxForce = Vector3.new(math.huge, maxForceY or 0, math.huge)
    BV.P = 100000  -- was 2500 — 40x more force = much faster acceleration
    BV.Velocity = Vector3.zero
    BV.Parent = RootPart
    return BV
end

--# Helper: Anti-stuck detector — teleports if position doesn't change
local function MakeAntiStuck()
    local lastPos = RootPart.Position
    local lastTime = os.clock()
    local stuckCount = 0

    return function(targetPos)
        local now = os.clock()
        local currentPos = RootPart.Position
        local moved = (currentPos - lastPos).Magnitude

        if moved < 0.5 and (now - lastTime) > 0.3 then
            stuckCount = stuckCount + 1
            if stuckCount >= 2 then
                -- Stuck for 2+ checks — teleport to target
                if targetPos then
                    RootPart.CFrame = CFrame.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
                end
                stuckCount = 0
                lastPos = RootPart.Position
                lastTime = now
                return true
            end
        else
            stuckCount = 0
        end

        lastPos = currentPos
        lastTime = now
        return false
    end
end

--# Helper: Compute horizontal velocity toward a target position
local function ComputeVelocity(currentPos, targetPos)
    local Offset = targetPos - currentPos
    local Horizontal = Vector3.new(Offset.X, 0, Offset.Z)
    local Distance = Horizontal.Magnitude

    if Distance < 0.05 then
        return Vector3.zero, Distance
    end

    -- Speed scales with distance: close=slow (precision), far=fast (cruise)
    local Speed = math.clamp(Distance * 30, 30, Func.MoveSpeed)
    return Horizontal.Unit * Speed, Distance
end

--# Helper: Discover all unique ore types by scanning the Ores folder's
-- "Currency" attribute on each ore model. Returns a sorted list with
-- "All" as the first entry. Returns just {"All"} if the folder is missing
-- or empty. This is used to populate the ore-type dropdown dynamically.
local function DiscoverOreTypes()
    local result = { "All" }
    local seen = { All = true }

    local ok, OresFolder = pcall(function()
        return workspace:FindFirstChild("Ores")
    end)
    if not ok or not OresFolder then
        return result
    end

    for _, Ore in OresFolder:GetChildren() do
        local ok2, currency = pcall(function()
            return Ore:GetAttribute("Currency")
        end)
        if ok2 and currency and currency ~= "" and not seen[currency] then
            seen[currency] = true
            table.insert(result, currency)
        end
    end

    -- Alphabetical sort (after "All")
    table.sort(result, function(a, b)
        if a == "All" then return true end
        if b == "All" then return false end
        return a:lower() < b:lower()
    end)

    return result
end

--# Auto loop handler
local function StartAutoLoop(Key, Action)
    task.spawn(function()
        Func[Key .. "Running"] = true

        while _G[Key] do
            local OK, Error = pcall(Action)
            if not OK then
                warn(("[AutoLoop] %s errored: %s"):format(Key, Error))
                -- Brief delay to avoid log spam on persistent errors
                task.wait(0.5)
            end
            if Func.LoopDelay > 0 then
                task.wait(Func.LoopDelay)
            else
                task.wait()  -- minimum yield (1 frame)
            end
        end

        Func[Key .. "Running"] = false
    end)
end

--# Features
local AutoTap = function(Bool)
    _G.AutoTap = Bool

    if Bool and not Func.AutoTapRunning then
        StartAutoLoop("AutoTap", function()
            -- Fire the Tap remote directly — no movement needed
            ReplicatedStorage.Remotes.Tap:FireServer()
        end)
    end
end

local AutoFarmFruits = function(Bool)
    _G.AutoFarmFruits = Bool

    if Bool and not Func.AutoFarmFruitsRunning then
        StartAutoLoop("AutoFarmFruits", function()
            local ClientFruits = workspace:WaitForChild("ClientFruits")
            local Event = ReplicatedStorage.Remotes.CollectFruit

            local StopDistance = Func.ReachDistance
            local TargetTimeout = 0.8  -- was 1.5
            local RemoveTimeout = 0.3  -- was 1.0

            local Collected = {}
            local Failed = {}

            -- Cache: list of available fruits sorted by distance.
            -- Refreshes at most every 0.1s instead of every frame.
            local cachedFruits = {}
            local lastCacheTime = 0

            local function GetSortedFruits()
                local now = os.clock()
                if now - lastCacheTime < 0.1 then
                    return cachedFruits
                end
                lastCacheTime = now

                cachedFruits = {}
                for _, Fruit in ClientFruits:GetChildren() do
                    local MainPart = Fruit:FindFirstChild("MainPart")
                    local ID = tonumber(Fruit.Name:match("_(%d+)$"))

                    if MainPart
                        and MainPart:IsA("BasePart")
                        and ID
                        and MainPart:IsDescendantOf(workspace)
                        and not Collected[ID]
                        and not Failed[ID] then

                        local Offset = MainPart.Position - RootPart.Position
                        local Distance = Vector3.new(Offset.X, 0, Offset.Z).Magnitude

                        table.insert(cachedFruits, {
                            Fruit = Fruit,
                            MainPart = MainPart,
                            ID = ID,
                            Distance = Distance,
                            Position = MainPart.Position,
                        })
                    end
                end

                -- Closest first
                table.sort(cachedFruits, function(a, b)
                    return a.Distance < b.Distance
                end)

                return cachedFruits
            end

            local antiStuck = MakeAntiStuck()

            while _G.AutoFarmFruits do
                local fruits = GetSortedFruits()

                if #fruits == 0 then
                    task.wait(0.05)  -- was 0.1
                    continue
                end

                local Target = fruits[1]
                local Fruit = Target.Fruit
                local MainPart = Target.MainPart
                local ID = Target.ID

                if not Fruit.Parent or not MainPart.Parent then
                    lastCacheTime = 0  -- force refresh next iteration
                    continue
                end

                local Position = MainPart.Position
                local Reached = false

                if Func.TeleportMode then
                    -- Instant teleport to the fruit
                    RootPart.CFrame = CFrame.new(Position.X, Position.Y + 3, Position.Z)
                    Reached = true
                else
                    local BV = CreateMover(0)  -- Y force=0 (horizontal only)
                    local StartTime = os.clock()

                    while _G.AutoFarmFruits
                        and Fruit.Parent
                        and MainPart.Parent
                        and os.clock() - StartTime < TargetTimeout do

                        local Offset = MainPart.Position - RootPart.Position
                        local Horizontal = Vector3.new(Offset.X, 0, Offset.Z)
                        local Distance = Horizontal.Magnitude

                        if Distance <= StopDistance then
                            Reached = true
                            BV.Velocity = Vector3.zero
                            break
                        end

                        if Distance > 0.05 then
                            local Speed = math.clamp(Distance * 30, 30, Func.MoveSpeed)
                            BV.Velocity = Horizontal.Unit * Speed
                        end

                        -- Anti-stuck: teleport if we're not making progress
                        if Func.AntiStuck then
                            antiStuck(Position)
                        end

                        task.wait()
                    end

                    BV:Destroy()

                    if not _G.AutoFarmFruits then break end
                end

                if not Reached and not Func.TeleportMode then
                    -- Timed out — temporarily mark as failed to try a different fruit
                    Failed[ID] = true
                    task.delay(0.5, function()  -- was 1.0
                        Failed[ID] = nil
                    end)
                    continue
                end

                if Fruit.Parent then
                    Collected[ID] = true

                    -- Use pcall to handle any remote errors gracefully
                    pcall(function()
                        Event:InvokeServer(ID)
                    end)

                    -- Wait briefly for the fruit to disappear (or timeout)
                    local RemoveStart = os.clock()
                    while _G.AutoFarmFruits
                        and Fruit.Parent
                        and os.clock() - RemoveStart < RemoveTimeout do
                        task.wait()
                    end

                    if not Fruit.Parent then
                        -- Successfully collected — clear the mark
                        Collected[ID] = nil
                    else
                        -- Fruit still here — collection probably failed
                        Collected[ID] = nil
                        Failed[ID] = true
                        task.delay(0.5, function()
                            Failed[ID] = nil
                        end)
                    end
                end

                -- Minimum yield between fruits (was task.wait(0.05))
                task.wait()
            end
        end)
    end
end

local AutoMineOres = function(Bool)
    _G.AutoMineOres = Bool

    if Bool and not Func.AutoMineOresRunning then
        StartAutoLoop("AutoMineOres", function()
            local OresFolder = workspace:WaitForChild("Ores")
            local StopDistance = Func.ReachDistance
            local TargetTimeout = 1.5  -- was 3

            local VerticalGain = 25  -- was 10 — faster vertical correction
            local MaxVerticalSpeed = 200  -- was 50 — 4x faster vertical

            local function GetPickaxeTier()
                local Pickaxe = Character:FindFirstChild("EquippedPickaxe")
                return Pickaxe and Pickaxe:GetAttribute("Tier") or 0
            end

            local function CanMineOre(Ore, PickaxeTier)
                local Required = Ore:GetAttribute("RequiredPickaxe")
                if not Required then return true end
                return PickaxeTier >= Required
            end

            -- Cache: list of available ores sorted by distance
            local cachedOres = {}
            local lastCacheTime = 0

            local function GetSortedOres(PickaxeTier)
                local now = os.clock()
                if now - lastCacheTime < 0.1 then
                    return cachedOres
                end
                lastCacheTime = now

                cachedOres = {}
                -- When a specific ore type is selected, only consider ores whose
                -- Currency attribute matches. "All" means take everything.
                local wantType = Func.TargetOreType

                for _, Ore in OresFolder:GetChildren() do
                    local Main = Ore:FindFirstChild("Main")
                    local MineRange = Ore:FindFirstChild("MineRange")

                    if Main
                        and MineRange
                        and Main:IsA("BasePart")
                        and MineRange:IsA("BasePart")
                        and Main.Color ~= Color3.new(0, 0, 0)
                        and CanMineOre(Ore, PickaxeTier)
                        and (wantType == "All"
                             or Ore:GetAttribute("Currency") == wantType) then

                        local Offset = MineRange.Position - RootPart.Position
                        local Distance = Vector3.new(Offset.X, 0, Offset.Z).Magnitude

                        table.insert(cachedOres, {
                            Ore = Ore,
                            Main = Main,
                            MineRange = MineRange,
                            Distance = Distance,
                            Position = MineRange.Position,
                        })
                    end
                end

                table.sort(cachedOres, function(a, b)
                    return a.Distance < b.Distance
                end)

                return cachedOres
            end

            local antiStuck = MakeAntiStuck()

            while _G.AutoMineOres do
                local PickaxeTier = GetPickaxeTier()
                local ores = GetSortedOres(PickaxeTier)

                if #ores == 0 then
                    task.wait(0.05)  -- was 0.1
                    continue
                end

                local Target = ores[1]
                local Ore = Target.Ore
                local Main = Target.Main
                local MineRange = Target.MineRange

                if not Ore.Parent or not Main.Parent or not MineRange.Parent then
                    lastCacheTime = 0
                    continue
                end

                local TargetPos = MineRange.Position
                local HoverPos = TargetPos + Vector3.new(0, Func.HoverHeight, 0)

                if Func.TeleportMode then
                    -- Instant teleport above the ore
                    RootPart.CFrame = CFrame.new(HoverPos.X, HoverPos.Y, HoverPos.Z)
                else
                    local BV = CreateMover(math.huge)  -- allow vertical movement
                    local StartTime = os.clock()

                    while _G.AutoMineOres
                        and Ore.Parent
                        and Main.Parent
                        and MineRange.Parent do

                        -- Stop if ore is depleted (turned black)
                        if Main.Color == Color3.new(0, 0, 0) then
                            break
                        end

                        if os.clock() - StartTime >= TargetTimeout then
                            break
                        end

                        local Target = MineRange.Position
                            + Vector3.new(0, Func.HoverHeight, 0)

                        local Offset = Target - RootPart.Position
                        local Horizontal = Vector3.new(Offset.X, 0, Offset.Z)
                        local Distance = Horizontal.Magnitude

                        local VerticalVelocity = math.clamp(
                            Offset.Y * VerticalGain,
                            -MaxVerticalSpeed,
                            MaxVerticalSpeed
                        )

                        local HorizontalVelocity = Vector3.zero
                        if Distance > StopDistance and Distance > 0.05 then
                            local Speed = math.clamp(Distance * 30, 30, Func.MoveSpeed)
                            HorizontalVelocity = Horizontal.Unit * Speed
                        end

                        BV.Velocity = Vector3.new(
                            HorizontalVelocity.X,
                            VerticalVelocity,
                            HorizontalVelocity.Z
                        )

                        -- Anti-stuck
                        if Func.AntiStuck then
                            antiStuck(Target)
                        end

                        task.wait()
                    end

                    BV:Destroy()
                end

                -- Minimum yield between ores (was task.wait(0.05))
                task.wait()
            end
        end)
    end
end

--# UI
local Window = MacLib:Window({
    Title = "Tap Incremental",
    Subtitle = "inject.sys · Improved",
    Size = UDim2.fromOffset(625, 425),
    DragStyle = 2,
    DisabledWindowControls = {},
    ShowUserInfo = true,
    Keybind = Enum.KeyCode.RightShift,
    AcrylicBlur = true,
})

local globalSettings = {
    UIBlurToggle = Window:GlobalSetting({
        Name = "UI Blur",
        Default = Window:GetAcrylicBlurState(),
        Callback = function(bool)
            Window:SetAcrylicBlurState(bool)
            Window:Notify({
                Title = Window.Settings.Title,
                Description = (bool and "Enabled" or "Disabled") .. " UI Blur",
                Lifetime = 5,
            })
        end,
    }),
    NotificationToggler = Window:GlobalSetting({
        Name = "Notifications",
        Default = Window:GetNotificationsState(),
        Callback = function(bool)
            Window:SetNotificationsState(bool)
            Window:Notify({
                Title = Window.Settings.Title,
                Description = (bool and "Enabled" or "Disabled") .. " Notifications",
                Lifetime = 5,
            })
        end,
    }),
    ShowUserInfo = Window:GlobalSetting({
        Name = "Show User Info",
        Default = Window:GetUserInfoState(),
        Callback = function(bool)
            Window:SetUserInfoState(bool)
            Window:Notify({
                Title = Window.Settings.Title,
                Description = (bool and "Showing" or "Redacted") .. " User Info",
                Lifetime = 5,
            })
        end,
    }),
}

