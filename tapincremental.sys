}, "ReachDistance")

sections.Right:Divider()

sections.Right:Paragraph({
    Header = "Info",
    Body = "Loop Delay throttles Auto Tap. Hover Height = how far above each ore the miner floats. Move Speed = max flight speed. Reach Distance = how close before triggering collection. Teleport Mode = instant teleport to targets (fastest). Anti-Stuck = auto-teleports if you stop moving. Target Ore Type = mine only that ore (via Currency attribute); All = mine everything. Options refresh every 5s as new ore types spawn.",
})

--# Config system
MacLib:SetFolder("TapIncremental")
tabs.Settings:InsertConfigSection("Left")

Window.onUnloaded(function()
    -- Stop every loop so nothing keeps running after the UI is gone
    _G.AutoTap = false
    _G.AutoFarmFruits = false
    _G.AutoMineOres = false
end)

tabs.Main:Select()
MacLib:LoadAutoLoadConfig()
